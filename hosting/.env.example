# Public judge website only (npm run build:judge). Copy to hosting/.env.local (never committed) and fill in the web app
# settings of the APPROVED demo Firebase project. Leave it out: everything works, cloud AI says "not set up".
# These values are public once the site is online: they are part of the JavaScript. Never put a secret here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check: reCAPTCHA Enterprise site key that is registered for the website's own domain.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: cloud model name. Empty = the SDK's default.
VITE_FIREBASE_AI_CLOUD_MODEL=

# Optional: full https address of the demo video. Empty = no video button on the landing page.
VITE_DEMO_VIDEO_URL=

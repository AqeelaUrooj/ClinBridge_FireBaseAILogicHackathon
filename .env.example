# Firebase AI Logic (hybrid inference). Copy to .env.local (never committed; .gitignore covers it) and fill in
# the values from Firebase console -> Project settings -> Your apps -> Web app config.
# Leave empty and ClinBridge still works fully: AI features show "not set up" and manual documentation is unchanged.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check (enforced for Firebase AI Logic). Site key of a reCAPTCHA Enterprise key registered for your
# production domain in Firebase console -> App Check. Only used for CLOUD requests (Practice compare, Back
# online second look); never needed for on-device inference.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only (npm run dev on localhost). "true" makes the App Check SDK print a debug token in the
# browser console; register it in Firebase console -> App Check -> Manage debug tokens. Ignored in production
# builds (import.meta.env.DEV is false). Never put the token itself in any file.
VITE_FIREBASE_APPCHECK_DEBUG=

# Optional: cloud model name override. Empty = the SDK's default cloud model.
VITE_FIREBASE_AI_CLOUD_MODEL=
